<!--
  Couch Companion Setup - window layout. Loaded at runtime (XamlReader), texts are set from
  Strings.cs (Polish / English), behaviour lives in MainWindow.cs.
-->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F3F4F6"
      TextElement.FontFamily="Segoe UI Variable Text, Segoe UI"
      TextElement.FontSize="13"
      TextElement.Foreground="#111827">

  <Grid.Resources>
    <SolidColorBrush x:Key="Accent" Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentHover" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="AccentPressed" Color="#1E40AF"/>
    <SolidColorBrush x:Key="Muted" Color="#6B7280"/>
    <SolidColorBrush x:Key="Line" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="Danger" Color="#DC2626"/>

    <!-- card -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="18,14"/>
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect BlurRadius="14" ShadowDepth="1" Direction="270" Opacity="0.07" Color="Black"/>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- text box: rounded, accent border when focused -->
    <Style TargetType="TextBox">
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="B" CornerRadius="6" BorderThickness="1" BorderBrush="#D1D5DB" Background="White">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="#2563EB"/>
                <Setter TargetName="B" Property="BorderThickness" Value="2"/>
              </Trigger>
              <Trigger Property="IsReadOnly" Value="True">
                <Setter TargetName="B" Property="Background" Value="#F9FAFB"/>
                <Setter Property="Foreground" Value="#6B7280"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="B" Property="Opacity" Value="0.55"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- buttons -->
    <Style x:Key="BaseButton" TargetType="Button">
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="18,0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#111827"/>
      <Setter Property="BorderBrush" Value="#D1D5DB"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" CornerRadius="6" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="#F3F4F6"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="B" Property="Background" Value="#E5E7EB"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="B" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" CornerRadius="6" Background="#2563EB">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="#1D4ED8"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="B" Property="Background" Value="#1E40AF"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="B" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Foreground" Value="{StaticResource Danger}"/>
      <Setter Property="BorderBrush" Value="#FCA5A5"/>
    </Style>
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Padding" Value="12,0"/>
    </Style>

    <!-- toggle switch (a CheckBox) -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,0,14"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ContentPresenter VerticalAlignment="Center" Margin="0,0,16,0"/>
              <Border x:Name="Track" Grid.Column="1" Width="42" Height="24" CornerRadius="12" Background="#D1D5DB" VerticalAlignment="Center">
                <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0">
                  <Ellipse.Effect>
                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.25"/>
                  </Ellipse.Effect>
                </Ellipse>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="#2563EB"/>
                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- status tile -->
    <Style x:Key="Tile" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Padding" Value="16,12"/>
      <Setter Property="Margin" Value="0,0,12,0"/>
    </Style>
    <Style x:Key="TileLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="TileValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
  </Grid.Resources>

  <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>   <!-- header -->
    <RowDefinition Height="Auto"/>   <!-- banner -->
    <RowDefinition Height="*"/>      <!-- content -->
    <RowDefinition Height="Auto"/>   <!-- footer -->
  </Grid.RowDefinitions>

  <!-- ===================================================== header -->
  <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
    <Grid>
      <Grid Margin="28,14,28,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Width="44" Height="44" CornerRadius="10" Background="#EFF6FF" VerticalAlignment="Center">
          <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22"
                     Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock x:Name="SubtitleText" Foreground="#6B7280" Margin="0,2,0,0"/>
        </StackPanel>
        <Border x:Name="InstalledPill" Grid.Column="2" CornerRadius="14" Padding="14,6" VerticalAlignment="Center" Background="#F3F4F6">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="InstalledDot" Width="8" Height="8" Fill="#9CA3AF" VerticalAlignment="Center"/>
            <TextBlock x:Name="InstalledText" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="#374151"/>
          </StackPanel>
        </Border>
      </Grid>
      <ProgressBar x:Name="Busy" Height="3" VerticalAlignment="Bottom" IsIndeterminate="True" Visibility="Collapsed"
                   Background="Transparent" BorderThickness="0" Foreground="#2563EB"/>
    </Grid>
  </Border>

  <!-- ===================================================== "accept on the TV" banner -->
  <Border x:Name="Banner" Grid.Row="1" Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="0,0,0,1"
          Padding="28,10" Visibility="Collapsed">
    <StackPanel Orientation="Horizontal">
      <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="#92400E" VerticalAlignment="Center"/>
      <TextBlock x:Name="BannerText" Margin="10,0,0,0" FontWeight="SemiBold" Foreground="#92400E" VerticalAlignment="Center"/>
    </StackPanel>
  </Border>

  <!-- ===================================================== content -->
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
    <Grid Margin="28,18,28,18">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- status tiles -->
      <Grid Grid.Row="0" Margin="0,0,-12,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Tile}" Grid.Column="0">
          <StackPanel>
            <TextBlock x:Name="TileTvLabel" Style="{StaticResource TileLabel}"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <Ellipse x:Name="TileTvDot" Width="10" Height="10" Fill="#9CA3AF" VerticalAlignment="Center"/>
              <TextBlock x:Name="TileTvValue" Style="{StaticResource TileValue}" Text="..."/>
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Tile}" Grid.Column="1">
          <StackPanel>
            <TextBlock x:Name="TileHelperLabel" Style="{StaticResource TileLabel}"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <Ellipse x:Name="TileHelperDot" Width="10" Height="10" Fill="#9CA3AF" VerticalAlignment="Center"/>
              <TextBlock x:Name="TileHelperValue" Style="{StaticResource TileValue}" Text="..."/>
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Tile}" Grid.Column="2">
          <StackPanel>
            <TextBlock x:Name="TileTasksLabel" Style="{StaticResource TileLabel}"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <Ellipse x:Name="TileTasksDot" Width="10" Height="10" Fill="#9CA3AF" VerticalAlignment="Center"/>
              <TextBlock x:Name="TileTasksValue" Style="{StaticResource TileValue}" Text="..."/>
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Tile}" Grid.Column="3">
          <StackPanel>
            <TextBlock x:Name="TileShutdownLabel" Style="{StaticResource TileLabel}"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <Ellipse x:Name="TileShutdownDot" Width="10" Height="10" Fill="#9CA3AF" VerticalAlignment="Center"/>
              <TextBlock x:Name="TileShutdownValue" Style="{StaticResource TileValue}" Text="..."/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <!-- TV + behaviour cards -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" Grid.Column="0">
          <StackPanel>
            <DockPanel>
              <Button x:Name="RefreshButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Height="28" Margin="0,-6,-8,0" VerticalAlignment="Top"/>
              <TextBlock x:Name="TvCardTitle" Style="{StaticResource CardTitle}"/>
            </DockPanel>

            <TextBlock x:Name="IpLabel" Style="{StaticResource FieldLabel}"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="IpBox" MaxLength="15"/>
              <Button x:Name="FindButton" Grid.Column="1" Style="{StaticResource BaseButton}" Margin="8,0,0,0" Height="34"/>
            </Grid>
            <TextBlock x:Name="IpError" Foreground="#DC2626" FontSize="12" Margin="0,4,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>

            <TextBlock x:Name="FoundLabel" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
            <ComboBox x:Name="FoundBox"/>

            <TextBlock x:Name="MacLabel" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
            <TextBox x:Name="MacBox" IsReadOnly="True" Focusable="False"/>

            <TextBlock x:Name="InputLabel" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
            <ComboBox x:Name="InputBox"/>
            <TextBlock x:Name="InputHint" Style="{StaticResource Hint}" Margin="0,6,0,0"/>

            <TextBlock Margin="0,14,0,0">
              <Hyperlink x:Name="PrereqLink" Foreground="#2563EB" TextDecorations="None"><Run x:Name="PrereqText"/></Hyperlink>
            </TextBlock>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Grid.Column="2">
          <StackPanel>
            <TextBlock x:Name="SettingsCardTitle" Style="{StaticResource CardTitle}"/>

            <CheckBox x:Name="KeepOnRestartSwitch" Style="{StaticResource Switch}">
              <TextBlock x:Name="KeepOnRestartText" TextWrapping="Wrap"/>
            </CheckBox>

            <CheckBox x:Name="WakeOnInputSwitch" Style="{StaticResource Switch}" Margin="0,0,0,6">
              <TextBlock x:Name="WakeOnInputText" TextWrapping="Wrap"/>
            </CheckBox>
            <DockPanel Margin="0,0,0,14">
              <TextBox x:Name="GraceBox" DockPanel.Dock="Right" Width="64" HorizontalContentAlignment="Center" MaxLength="3"/>
              <TextBlock x:Name="GraceText" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            </DockPanel>

            <CheckBox x:Name="KeepOffSwitch" Style="{StaticResource Switch}" Margin="0,0,0,4">
              <TextBlock x:Name="KeepOffText" TextWrapping="Wrap"/>
            </CheckBox>
            <TextBlock x:Name="KeepOffHint" Style="{StaticResource Hint}" Margin="0,0,58,14"/>

            <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,14"/>
            <CheckBox x:Name="PowerTestSwitch" Style="{StaticResource Switch}" Margin="0">
              <TextBlock x:Name="PowerTestText" TextWrapping="Wrap"/>
            </CheckBox>
          </StackPanel>
        </Border>
      </Grid>

    </Grid>
  </ScrollViewer>

  <!-- ===================================================== footer -->
  <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
    <Grid Margin="28,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button x:Name="DetailsButton" Style="{StaticResource GhostButton}" Margin="-12,0,8,0"/>
      <TextBlock x:Name="StatusText" Grid.Column="1" VerticalAlignment="Center" Foreground="#6B7280" TextTrimming="CharacterEllipsis"/>
      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button x:Name="UninstallButton" Style="{StaticResource DangerButton}" Margin="0,0,10,0"/>
        <Button x:Name="CloseButton" Style="{StaticResource BaseButton}" Margin="0,0,10,0" IsCancel="True"/>
        <Button x:Name="InstallButton" Style="{StaticResource PrimaryButton}" MinWidth="140" IsDefault="True"/>
      </StackPanel>
    </Grid>
  </Border>
</Grid>
